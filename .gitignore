# Dependencies
node_modules/

# Build output
.next/
out/
dist/
*.tsbuildinfo

# Use pnpm only — pnpm-lock.yaml IS committed for reproducible installs
yarn.lock
package-lock.json

# Environment files: never commit real keys (only the template is tracked)
.env*
!.env.example

# Keys and certificates
*.pem
*.key
*.p12

# Hosting / tooling
.vercel/
supabase/.temp/
coverage/

# Claude Code: personal settings and locally installed skills stay out of git
.claude/settings.local.json
.claude/skills/
__pycache__/

# unslop skill output (snapshots/screenshots can capture real data)
unslop/
unslop-story/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Misc
.DS_Store
Thumbs.db
*.tmp

# Editors
.vscode/
.idea/
