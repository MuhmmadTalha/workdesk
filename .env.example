# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.

# Public (sent to the browser). Safe to expose: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET — server only. Used by app/api/admin/employees to create/reset/delete accounts.
# Never commit it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
